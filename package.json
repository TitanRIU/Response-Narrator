{
  "name": "response-narrator",
  "displayName": "Response Narrator",
  "description": "Reads new Claude Code assistant responses aloud via TTS by watching its session transcript files",
  "version": "0.0.1",
  "publisher": "TitanRIU",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/TitanRIU/Response-Narrator.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "response-narrator.openMenu",
        "title": "Response Narrator: Open Menu"
      },
      {
        "command": "response-narrator.togglePlayback",
        "title": "Response Narrator: Play/Pause"
      },
      {
        "command": "response-narrator.selectVoice",
        "title": "Response Narrator: Select Voice"
      },
      {
        "command": "response-narrator.stopSpeaking",
        "title": "Response Narrator: Stop Speaking"
      }
    ],
    "keybindings": [
      {
        "command": "response-narrator.togglePlayback",
        "key": "ctrl+alt+p"
      },
      {
        "command": "response-narrator.stopSpeaking",
        "key": "ctrl+alt+s"
      }
    ],
    "configuration": {
      "title": "Response Narrator",
      "properties": {
        "response-narrator.playbackMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "enumDescriptions": [
            "Read new responses aloud automatically as they arrive.",
            "Only read a response when you press play."
          ],
          "default": "auto",
          "description": "Whether responses are read automatically or only on demand."
        },
        "response-narrator.rate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Speech rate for narrated responses (1 = normal speed)."
        },
        "response-narrator.voiceEngine": {
          "type": "string",
          "enum": [
            "system",
            "enhanced"
          ],
          "enumDescriptions": [
            "Built-in OS voices — instant, works offline.",
            "Higher-quality neural voices via Microsoft Edge's online text-to-speech service (unofficial API; requires network access, with automatic fallback to System voices if it fails)."
          ],
          "default": "system",
          "description": "Which text-to-speech engine to use."
        },
        "response-narrator.voice": {
          "type": "string",
          "default": "",
          "description": "Name of the System engine speech synthesis voice to use. Leave empty for the system default. Use the 'Response Narrator: Select Voice' command to choose one."
        },
        "response-narrator.enhancedVoice": {
          "type": "string",
          "default": "",
          "description": "Short name of the Enhanced engine voice to use (e.g. en-US-AriaNeural). Leave empty for the default voice. Use the 'Response Narrator: Select Voice' command to choose one."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "msedge-tts": "^2.0.7"
  }
}
